# Salin file ini menjadi .env, lalu isi kredensial asli.
# .env tidak boleh di-commit karena sudah masuk .gitignore.

# --- Akun SIBUNDA ---
SIBUNDA_USERNAME=
SIBUNDA_PASSWORD=
SIBUNDA_BASE_URL=https://sibunda.surabaya.go.id
SIBUNDA_VERIFY_PATH=/paud_mutu/paudmutu/halaman_verifikasi
SIBUNDA_TAHUN=2026

# Browser: false = headful (bisa diamati), true = tanpa jendela
SIBUNDA_HEADLESS=false
SIBUNDA_SLOW_MO_MS=500
SIBUNDA_ACTION_TIMEOUT_MS=20000
SIBUNDA_NAV_TIMEOUT_MS=60000
SIBUNDA_PERSIST_SESSION=true

# --- Daftar NPSN (CSV lokal, header wajib: NPSN) ---
NPSN_CSV_PATH=npsn_list.csv

# --- Rubrik penilaian (Google Sheets) ---
GSHEET_ID=1XEzU4gPyJcZPobEFwKeSehmwczQ2jRQS
GSHEET_GID_RUBRIK=1218752796
# Kosongkan bila sheet bisa dibaca publik
GOOGLE_CREDENTIALS_FILE=

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=700
DEEPSEEK_TIMEOUT_S=90
DEEPSEEK_MAX_RETRIES=3

# --- Ekstraksi dokumen ---
# Tesseract portable di dalam proyek, tidak butuh PATH Windows
TESSERACT_DIR=bin/tesseract
OCR_LANG=ind
OCR_DPI=300
MAX_DOC_CHARS=60000
MIN_TEXT_CHARS=80
PAGE_TEXT_MIN_CHARS=40
MAX_PDF_PAGES=40
MAX_DOWNLOAD_MB=60
HTTP_TIMEOUT_S=120

# --- Perilaku verifikasi ---
# Ambang minimal skor kemiripan judul indikator web vs rubrik (0-1)
MATCH_THRESHOLD=0.52
# Lewati indikator yang sudah terisi di SIBUNDA
SKIP_FILLED=true
SAVE_WAIT_MS=2500
# Jeda tunggu setelah klik skor sebelum halaman selesai render ulang (ms)
RERENDER_WAIT_MS=1000

# --- Web UI (Streamlit) ---
# Kata sandi halaman web; wajib diisi agar UI bisa dibuka
APP_PASSWORD=ganti-dengan-password-kuat
# Lokasi database SQLite untuk state indikator yang sudah tersimpan
DATABASE_PATH=database.db
